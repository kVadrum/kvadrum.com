// Cloudflare Workers static-assets site — no Worker script, no build step.
// Deploy from the repo root: `npx wrangler deploy` (KeMeK account).
// What ships is decided by .assetsignore, which is an allowlist.
{
  "name": "kvadrum",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "."
  },
  // Served only on the real domains; no *.workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kvadrum.com", "custom_domain": true },
    { "pattern": "www.kvadrum.com", "custom_domain": true }
  ]
}
