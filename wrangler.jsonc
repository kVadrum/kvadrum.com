// Cloudflare Workers static-assets site — no Worker script, no build step.
// Deploy from the repo root: `npx wrangler deploy` (KeMeK account).
// The assets directory is public/, which holds only files meant to be served:
// the repo root also holds local-only files (STATE.md, CLAUDE.md, .claude/),
// and an ignore-file guarding them fails open the day it is emptied.
// public/LICENSE is a symlink to the root LICENSE, which wrangler follows.
{
  "name": "kvadrum",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public"
  },
  // Served only on the real domains; no *.workers.dev or preview copies.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kvadrum.com", "custom_domain": true },
    { "pattern": "www.kvadrum.com", "custom_domain": true }
  ]
}
